# ─── CyberTrack Nexus — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in actual values.
# NEVER commit the real .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="CyberTrack Nexus"
ENVIRONMENT=development
DEBUG=false

# ── Database — Neon PostgreSQL ────────────────────────────────────────────────
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── JWT (dev-mode auth) ───────────────────────────────────────────────────────
# IMPORTANT: Change this to a random 64-character string in production.
# Use: python -c "import secrets; print(secrets.token_hex(32))"
DEV_AUTH_ENABLED=true
JWT_SECRET_KEY=CHANGE_ME_USE_SECRETS_MANAGER_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173"]

# ── File Storage ──────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# For S3:
# STORAGE_BACKEND=s3
# S3_BUCKET=cybertrack-evidence
# S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Security ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".png",".jpg",".jpeg"]

# ── Scheduler ────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=360

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
